{
  "name": "@kenkaiiii/gg-ai",
  "version": "5.100.1",
  "type": "module",
  "description": "One streaming API for 12 LLM providers and local models: Anthropic, OpenAI, Gemini, xAI, Moonshot, GLM, DeepSeek, OpenRouter and more. Tool calls, reasoning, embeddings and reranking.",
  "author": "Ken Kai",
  "keywords": [
    "llm",
    "ai",
    "streaming",
    "anthropic",
    "openai",
    "gemini",
    "openrouter",
    "ollama",
    "tool-calling",
    "embeddings"
  ],
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KenKaiii/gg-framework.git",
    "directory": "packages/gg-ai"
  },
  "homepage": "https://github.com/KenKaiii/gg-framework/tree/main/packages/gg-ai#readme",
  "bugs": {
    "url": "https://github.com/KenKaiii/gg-framework/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "openai": "^7.54.0",
    "undici": "7.25.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
