{
  "name": "@kenkaiiii/gg-agent",
  "version": "5.93.0",
  "type": "module",
  "description": "Agent loop for LLMs: runs your tools, feeds results back and loops until done, with retries, steering and cancellation. Works with every gg-ai provider.",
  "author": "Ken Kai",
  "keywords": [
    "llm",
    "ai",
    "agent",
    "agent-loop",
    "tool-calling",
    "anthropic",
    "openai"
  ],
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KenKaiii/gg-framework.git",
    "directory": "packages/gg-agent"
  },
  "homepage": "https://github.com/KenKaiii/gg-framework/tree/main/packages/gg-agent#readme",
  "bugs": {
    "url": "https://github.com/KenKaiii/gg-framework/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kenkaiiii/gg-ai": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
