{
  "version": 1,
  "tools": [
    {
      "name": "bash",
      "description": "Run a non-interactive bash command (TERM=dumb, pipefail) in the project root. Servers/watchers/REPLs: run_in_background + wake.pattern, then task_output wait_ms; never `&`, nohup or sleep. Leave servers running. Kill by exact PID.",
      "schema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "review": {
            "description": "Append git diff after a passing final check",
            "type": "boolean"
          },
          "timeout": {
            "type": "integer",
            "minimum": 1000
          },
          "run_in_background": {
            "type": "boolean"
          },
          "persist": {
            "description": "Keep cd/env across calls",
            "type": "boolean"
          },
          "wake": {
            "description": "Notify on output match or silence",
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "silence_seconds": {
                "type": "integer",
                "minimum": 10,
                "maximum": 3600
              }
            }
          }
        },
        "required": [
          "command"
        ]
      },
      "hash": "23b49343843555ff1a22ece3ab3796e58a867fb685da2d8226a5101be0d4be27"
    },
    {
      "name": "checklist",
      "description": "Read or record the project health checklist (stored in .gg-checklist.json). `status` lists every item with its status and last check; items older than 30 days are due. `record` saves the result of checking one item: the date and Git commit are filled in automatically. `issues` needs at least one finding; `pass` takes none; `evidence` lists what you actually ran or read, including scope and exclusions. Record completed checklist reviews or checks requested in normal chat; never start extra audits unasked. After fixing an item's recorded findings, re-check them and record that item again (`pass`, or `issues` with what remains) so the checklist doesn't keep showing fixed findings. Findings the user explicitly chose to leave go in `accepted` with the reason, not `findings`, so the item can pass once everything else is fixed.",
      "schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "status: every item with its status and last check. record: save the result of checking one item.",
            "enum": [
              "status",
              "record"
            ]
          },
          "id": {
            "type": "string",
            "enum": [
              "agent-setup",
              "docs",
              "naming",
              "git-github",
              "secrets",
              "quality-tools",
              "tests",
              "ci",
              "commit-gate",
              "code-health",
              "errors-logging",
              "dependencies",
              "design-system",
              "styling-consistency",
              "motion-consistency",
              "accessibility",
              "ui-states",
              "security",
              "data-safety",
              "compliance",
              "performance",
              "build-release",
              "monitoring",
              "senior-review"
            ],
            "description": "record: the checklist item id"
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "issues",
              "not-applicable"
            ],
            "description": "record: pass, issues (needs findings) or not-applicable"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "record: one-line verdict in plain words"
          },
          "findings": {
            "default": [],
            "description": "record: each problem with file:line, severity and suggested fix",
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "accepted": {
            "default": [],
            "description": "record: findings the user explicitly chose to leave as is, each with the reason (e.g. 'deferred by owner'); they don't block pass",
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "evidence": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": "record: what was actually run or read, e.g. 'pnpm lint — 0 errors'"
          }
        },
        "required": [
          "action"
        ]
      },
      "hash": "f98a045f33438ea0a876478cc380ede7436542697d4ffbcffbb399df51080e4d"
    },
