              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "width",
              "height"
            ]
          },
          "full_page": {
            "description": "Capture the full scrollable page (default false)",
            "type": "boolean"
          },
          "actions": {
            "description": "Optional interactions (click/type/wait) to run before capturing",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
