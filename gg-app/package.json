{
  "name": "gg-app",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.111.2",
  "description": "GG Coder desktop app: Tauri + React workspace for code, chat and motion agents",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "tsc --noEmit",
    "lint": "eslint --cache 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint --cache 'src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,html,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css,html,json}'",
    "preview": "vite preview",
    "stage:node": "node scripts/stage-node.mjs",
    "bundle:sidecar": "node scripts/bundle-sidecar.mjs",
    "prebundle": "pnpm stage:node && pnpm bundle:sidecar",
    "installer:art": "node installer/build-art.mjs",
    "bump": "node scripts/bump-version.mjs",
    "test": "vitest run",
    "smoke:packaged": "node scripts/smoke-packaged-windows.mjs",
    "smoke:packaged:linux": "node scripts/smoke-packaged-linux.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "2.5.2",
    "@tauri-apps/plugin-log": "^2.9.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "border-beam": "1.3.0",
    "highlight.js": "^11.12.0",
    "marked": "^15.0.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remend": "1.4.0",
    "thinking-orbs": "0.3.2",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3.7",
    "vitest": "^4.0.0"
  }
}
