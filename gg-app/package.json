{
  "name": "gg-app",
  "private": true,
  "version": "0.64.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "tsc --noEmit",
    "lint": "eslint --cache 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint --cache 'src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,html,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css,html,json}'",
    "preview": "vite preview",
    "stage:node": "node scripts/stage-node.mjs",
    "bundle:sidecar": "node scripts/bundle-sidecar.mjs",
    "prebundle": "pnpm stage:node && pnpm bundle:sidecar",
    "installer:art": "node installer/build-art.mjs",
    "bump": "node scripts/bump-version.mjs",
    "test": "vitest run",
    "smoke:packaged": "node scripts/smoke-packaged-windows.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.18",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-log": "^2.9.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.42.0",
    "marked": "^15.0.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.6.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.4",
    "vitest": "^4.0.0"
  }
}
