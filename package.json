{
  "name": "gg-framework",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\" && pnpm --filter matey lint && pnpm --filter gg-app lint",
    "lint:fix": "eslint \"packages/*/src/**/*.{ts,tsx}\" --fix && pnpm --filter matey lint:fix && pnpm --filter gg-app lint:fix",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"Matey/**/*.{ts,tsx,css,html,json,md,yml}\" && pnpm --filter gg-app format",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\" \"Matey/**/*.{ts,tsx,css,html,json,md,yml}\" && pnpm --filter gg-app format:check",
    "test": "pnpm test:audit-generated && pnpm --filter @kenkaiiii/gg-ai test && pnpm --filter @kenkaiiii/gg-agent test && pnpm --filter @kenkaiiii/gg-core test && pnpm --filter @kenkaiiii/ggcoder test && pnpm --filter @kenkaiiii/gg-boss test && pnpm --filter gg-app test",
    "test:audit-generated": "node --test scripts/audit-generated.test.mjs",
    "bench": "pnpm build && npx tsx benchmarks/run-comparison.ts",
    "prepare": "pnpm build",
    "app:update:local-fixes": "pnpm --filter gg-app update:local-fixes",
    "app:build:local-patched": "pnpm --filter gg-app build:local-patched",
    "audit:generated:web": "node scripts/audit-generated.mjs web",
    "audit:generated:tauri": "node scripts/audit-generated.mjs tauri",
    "audit:generated:sidecar-deps": "node scripts/audit-generated.mjs sidecar-deps",
    "audit:generated:tauri-schemas": "node scripts/audit-generated.mjs tauri-schemas",
    "audit:generated:cache": "node scripts/audit-generated.mjs cache",
    "audit:generated:packages": "node scripts/audit-generated.mjs packages"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript-eslint": "^8.59.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@electron/get",
      "better-sqlite3",
      "electron",
      "esbuild",
      "onnxruntime-node"
    ],
    "overrides": {
      "global-agent": "^4.1.3",
      "ip-address": "^10.1.1"
    },
    "patchedDependencies": {
      "ink@7.0.2": "patches/ink@7.0.2.patch"
    }
  },
  "dependencies": {
    "marked": "^15.0.12",
    "playwright": "^1.60.0"
  }
}
