{
  "name": "gg-framework",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "lint": "eslint 'packages/*/src/**/*.{ts,tsx}' && pnpm --filter gg-app lint",
    "lint:fix": "eslint 'packages/*/src/**/*.{ts,tsx}' --fix && pnpm --filter gg-app lint:fix",
    "format": "prettier --write 'packages/*/src/**/*.{ts,tsx}' && pnpm --filter gg-app format",
    "format:check": "prettier --check 'packages/*/src/**/*.{ts,tsx}' && pnpm --filter gg-app format:check",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript-eslint": "^8.70.0"
  }
}
